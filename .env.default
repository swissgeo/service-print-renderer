# used for local development
AWS_REGION=eu-central-1
# to suppress docker compose warning AWS_KEY not set
AWS_ACCESS_KEY_ID=123
AWS_SECRET_ACCESS_KEY=123
 # boolean TRUE or FALSE
AWS_LOCAL=true
 # localstack port and endpoint for local AWS services such as dynamodb and sqs
LOCALSTACK_PORT=4566
LOCALSTACK_ENDPOINT=http://localhost:${LOCALSTACK_PORT}

DYNAMODB_TABLE_NAME="service-print-jobs-local"
SQS_QUEUE_NAME="service-print-jobs-queue-local"
AWS_CONNECT_TIMEOUT=5
AWS_READ_TIMEOUT=30

# SQS polling configuration
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=1

# S3
S3_BUCKET_NAME=service-print-pdf-local
S3_PRESIGNED_URL_EXPIRY=3600

# Webmapviewer endpoints
VIEWER_URL_MAP_RASTER=https://sys-map.dev.bgdi.ch/preview/fix-pb-1522-print-conf-logo-text-width/index.html#/print
VIEWER_URL_MAP=https://sys-map.dev.bgdi.ch/preview/poc-maplibre-layer/index.html#/print
VIEWER_URL_LEGEND=https://sys-map.dev.bgdi.ch/preview/feat-pb-1613-print-legend-view/index.html#/print-legend

# Rendering
VECTOR_TILES=true
TIMEOUT_LOADING_WEB_PAGE=30000
ROUND_UP_TO_NEXT_Z_INT=true
GO_ONE_Z_FURTHER=false

# OTEL
OTEL_SDK_DISABLED=false
OTEL_ENABLE_LOGGING=true
OTEL_ENABLE_BOTOCORE=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_RESOURCE_ATTRIBUTES=service.name=service-print-renderer
